{
  "name": "graph-editor-pro",
  "version": "1.0.0",
  "private": true,
  "description": "A self-contained, offline graph editor built from maintainable TypeScript sources.",
  "type": "module",
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "typecheck": "tsc --noEmit",
    "build": "node scripts/clean.mjs && tsc && node scripts/build.mjs && node scripts/check-static.mjs",
    "check:static": "node scripts/check-static.mjs",
    "test": "npm run build && node --test tests/*.test.mjs",
    "check": "npm run typecheck && npm test"
  },
  "devDependencies": {
    "jsdom": "26.1.0",
    "playwright": "^1.62.1",
    "typescript": "5.9.2"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@sparticuz/chromium": "^149.0.0",
    "ws": "^8.21.3"
  }
}
